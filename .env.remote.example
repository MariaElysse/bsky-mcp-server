# Public HTTPS URL this server is reachable at. Must match the hostname
# Caddy (or your reverse proxy) serves, because the ATProto OAuth client
# uses `${PUBLIC_URL}/oauth/client-metadata.json` as its client_id and the
# PDS will refuse to honour a mismatch.
PUBLIC_URL=https://bsky-mcp.example.com

# Loopback interface + port the Node process listens on. Put a reverse
# proxy in front that terminates TLS and forwards to this.
HOST=127.0.0.1
PORT=8787

# Where SQLite and the signing key live. Must be writable by the service
# account. Defaults to /var/lib/bsky-mcp when unset.
DATA_DIR=/var/lib/bsky-mcp

# Optional explicit overrides; default to files under DATA_DIR.
# SIGNING_KEY_PATH=/var/lib/bsky-mcp/signing-keys.json
# DB_PATH=/var/lib/bsky-mcp/data.db
