# Append to your existing Caddyfile (keep the global options block at the top).
# This matches the style of the adjacent PDS block on lizthegrey.com's deployment.
bsky-mcp.lizthegrey.com {
	tls {
		on_demand
	}
	encode gzip
	# Streamable HTTP responses mustn't be buffered.
	reverse_proxy http://localhost:8787 {
		flush_interval -1
	}
}
